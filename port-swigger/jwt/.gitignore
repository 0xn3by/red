# Private key material — never commit. Public key.pem files are kept as
# evidence intentionally, but anything that looks like a private key is ignored.
*private*.pem
*-private.pem
id_rsa
id_rsa.*
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / OS cruft
*.swp
*.swo
.DS_Store
